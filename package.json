{
  "name": "psm-reviewer",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Scrum Master I (PSM I) practice question bank and web app",
  "scripts": {
    "build": "node build.js",
    "start": "node server.js",
    "dev": "node build.js && node server.js",
    "sync:mobile": "node -e \"require('fs').copyFileSync('questions.json','mobile/src/data/questions.json')\" && echo \"synced questions.json -> mobile/src/data/\"",
    "build:all": "npm run build && npm run sync:mobile"
  },
  "engines": {
    "node": ">=18"
  }
}
